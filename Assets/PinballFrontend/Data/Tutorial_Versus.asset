  pages:
  - title: "\u30EB\u30FC\u30EB"
    image: {fileID: 2800000, guid: a69433d1af153cd42b951fad38d0f54c, type: 3}
    body: "\u30FB\u76F8\u624B\u306E\u30B4\u30FC\u30EB\uFF08\u76F8\u624B\u5074\u306E\u7AEF\uFF09\u306B\u7403\u3092\u5165\u308C\u308B\u3068
      1 \u70B9\u3002\n\u30FB\u53F0\u306F\u771F\u3093\u4E2D\u304C\u5C71\u3002\u7403\u306F\u3001\u4ECA\u3044\u308B\u5074\u306E\u30B4\u30FC\u30EB\u3078\u8EE2\u304C\u3063\u3066\u3044\u304F\u3002\n\u30FB\u5148\u306B\u6C7A\u3081\u305F\u70B9\u6570\uFF083\uFF0F5\uFF0F10
      \u70B9\uFF09\u3092\u53D6\u3063\u305F\u65B9\u306E\u52DD\u3061\u3002\n\u30FB\u81EA\u5206\u306E\u30B4\u30FC\u30EB\u306F\u3001{L}\uFF0F{R}
      \u306E\u30D5\u30EA\u30C3\u30D1\u30FC\u3067\u5B88\u308B\u3002"
  - title: "\u64CD\u4F5C"
    image: {fileID: 2800000, guid: 79ab98ff5cb33b644a05736a17c4cf75, type: 3}
    body: '{ControlsTable}'
  - title: "\u30B5\u30FC\u30D6"
    image: {fileID: 2800000, guid: 81b69d2e456fad348a4ef0e018ad5ad8, type: 3}
    body: "\u30FB\u30B5\u30FC\u30D6\u756A\u306E\u3068\u304D\u306B\u3001{Serve} \u3092\u9577\u62BC\u3057\u3067\u6E9C\u3081\u3066\u3001\u96E2\u3059\u3068\u767A\u5C04\u3002\n\u30FB\u6253\u3064\u524D\u306A\u3089
      {Route} \u3067\u3001\u81EA\u9663\u30EB\u30FC\u30C8\uFF0F\u76F8\u624B\u9663\u5730\u30EB\u30FC\u30C8\u3092\u5207\u308A\u66FF\u3048\u3089\u308C\u308B\u3002\n\u30FB\u5F31\u3059\u304E\u3066\u623B\u3063\u3066\u304F\u308B\u3068\u30D5\u30A9\u30EB\u30C8\u30022
      \u56DE\u7D9A\u304F\u3068\u76F8\u624B\u306B 1 \u70B9\u3002\n\u30FB\u30B5\u30FC\u30D6\u306F
      2 \u672C\u3054\u3068\u306B\u4EA4\u4EE3\u3002"
  - title: "\u30D6\u30ED\u30C3\u30AB\u30FC"
    image: {fileID: 2800000, guid: 41eeadbf849f99c48b3afd98c3589302, type: 3}
    body: "\u30FB{Move} \u3067\u3001\u81EA\u5206\u306E\u9663\u5730\u306E\u30D6\u30ED\u30C3\u30AB\u30FC\u3092\u52D5\u304B\u3059\u3002\n\u30FB\u7403\u304C\u6765\u305F\u3089
      {Catch} \u3092\u62BC\u3057\u305F\u307E\u307E\u3067\u3064\u304B\u307F\u3001\u96E2\u3059\u3068\u767A\u5C04\uFF08{Move}
      \u306E\u5DE6\u53F3\u3067\u72D9\u3046\uFF09\u3002\n\u30FB\u5F53\u305F\u308B\u76F4\u524D\u306B
      {Bounce} \u3092\u62BC\u3059\u3068\u3001\u5F37\u304F\u8DF3\u306D\u8FD4\u3059\u3002\n\u30FB\u5F37\u3044\u7403\u304C\u5F53\u305F\u308B\u3068
      HP \u304C\u6E1B\u308A\u30010 \u306B\u306A\u308B\u3068\u3057\u3070\u3089\u304F\u30C0\u30A6\u30F3\u3002"
